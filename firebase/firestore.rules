rules_version = '2';

// Reguli de securitate Cloud Firestore pentru NewsFilter.
// - Datele publice (știri, cursuri) sunt scrise DOAR de jobul de sincronizare (Admin SDK,
//   care ocolește regulile) și pot fi citite doar de utilizatori autentificați.
// - Datele personale (favorite, voturi, profil) sunt accesibile doar proprietarului.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ID-urile articolelor sunt sha1(url)[0..20] — limităm doar lungimea.
    function validId(id) {
      return id.size() <= 64;
    }

    function str(d, k, max) {
      return d[k] is string && d[k].size() <= max;
    }

    // Câmp opțional: lipsă, null sau string de cel mult `max` caractere.
    function optStr(d, k, max) {
      return !(k in d) || d[k] == null || str(d, k, max);
    }

    function optList(d, k, max) {
      return !(k in d) || d[k] == null || (d[k] is list && d[k].size() <= max);
    }

    // users/{uid} — scris de AuthRepositoryImpl.saveProfile.
    function validProfile(d) {
      return d.keys().hasOnly(['name', 'email', 'authProvider', 'lastLoginAt', 'createdAt'])
        && str(d, 'name', 200)
        && str(d, 'email', 320)
        && d.authProvider in ['email', 'google']
        && d.lastLoginAt is timestamp
        && (!('createdAt' in d) || d.createdAt is timestamp);
    }

    // users/{uid}/bookmarks/{id} — NewsArticle.toBookmarkData() din FirestoreMappers.kt
    // (fullContent are max. 15 000 de caractere în jobul de sincronizare).
    function validBookmark(d) {
      return d.keys().hasOnly([
          'title', 'source', 'imageUrl', 'summary', 'articleUrl', 'readTimeMinutes',
          'category', 'publishedAt', 'fullContent', 'aiTitle', 'aiSummary', 'aiBullets', 'aiTags',
          'deepDive', 'affectedCurrency', 'marketSentiment', 'marketImpactNote', 'createdAt'])
        && str(d, 'title', 1000)
        && str(d, 'articleUrl', 2048)
        && optStr(d, 'source', 200)
        && optStr(d, 'imageUrl', 2048)
        && optStr(d, 'summary', 5000)
        && (!('readTimeMinutes' in d) || d.readTimeMinutes is int)
        && optStr(d, 'category', 50)
        && optStr(d, 'publishedAt', 100)
        && optStr(d, 'fullContent', 20000)
        && optStr(d, 'aiTitle', 1000)
        && optStr(d, 'aiSummary', 5000)
        && optList(d, 'aiBullets', 10)
        && optList(d, 'aiTags', 10)
        && optStr(d, 'deepDive', 10000)
        && optStr(d, 'affectedCurrency', 16)
        && (!('marketSentiment' in d) || d.marketSentiment == null
            || d.marketSentiment in ['UP', 'DOWN', 'NEUTRAL'])
        && optStr(d, 'marketImpactNote', 1000)
        && d.createdAt == request.time;
    }

    // users/{uid}/votes/{id} — NewsRepositoryImpl.setVote.
    function validVote(d) {
      return d.keys().hasOnly(['positive', 'votedAt'])
        && d.positive is bool
        && d.votedAt == request.time;
    }

    // Votul se scrie doar împreună cu contoarele din articles/{id} (același batch, același request.time).
    function votedInBatch(articleId) {
      return getAfter(/databases/$(database)/documents/articles/$(articleId)).data.updatedAt == request.time;
    }

    match /articles/{articleId} {
      allow read: if request.auth != null;
      // Singura scriere din aplicație: contoarele de voturi, în același batch cu
      // users/{uid}/votes/{articleId}. Fiecare contor se schimbă exact cu tranziția votului.
      allow update: if request.auth != null && validVoteUpdate(articleId);
      allow create, delete: if false;
    }

    function votePath(articleId) {
      return /databases/$(database)/documents/users/$(request.auth.uid)/votes/$(articleId);
    }

    function counterDelta(field) {
      return request.resource.data.get(field, 0) - resource.data.get(field, 0);
    }

    // delta == (după ? 1 : 0) - (înainte ? 1 : 0)
    function deltaMatches(delta, before, after) {
      return (delta == 1 && after && !before)
          || (delta == -1 && before && !after)
          || (delta == 0 && before == after);
    }

    function validVoteUpdate(articleId) {
      let p = votePath(articleId);
      let had = exists(p);
      let has = existsAfter(p);
      let upBefore = had && get(p).data.positive == true;
      let downBefore = had && get(p).data.positive == false;
      let upAfter = has && getAfter(p).data.positive == true;
      let downAfter = has && getAfter(p).data.positive == false;
      let du = counterDelta('upvotes');
      let dd = counterDelta('downvotes');
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'downvotes', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && (du != 0 || dd != 0)
          && request.resource.data.get('upvotes', 0) >= 0
          && request.resource.data.get('downvotes', 0) >= 0
          && deltaMatches(du, upBefore, upAfter)
          && deltaMatches(dd, downBefore, downAfter);
    }

    match /market/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /market_history/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Datele personale: doar profilul, favoritele și voturile, doar pentru proprietar.
    // Cheile și mărimile sunt validate ca un cont să nu poată umple baza de date / cota comună;
    // orice altă subcolecție de sub users/{uid} cade pe regula finală (închisă).
    match /users/{uid} {
      allow read: if isOwner(uid);
      // set(merge): request.resource.data este documentul rezultat după îmbinare.
      allow create, update: if isOwner(uid) && validProfile(request.resource.data);

      match /bookmarks/{articleId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validId(articleId)
          && validBookmark(request.resource.data);
      }

      // Voturile: doar în același batch cu actualizarea contoarelor articolului (verificată mai sus),
      // altfel s-ar putea șterge / rescrie votul fără a corecta contoarele.
      match /votes/{articleId} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid) && votedInBatch(articleId);
        allow create, update: if isOwner(uid) && validId(articleId) && votedInBatch(articleId)
          && validVote(request.resource.data);
      }
    }

    // meta/* (indexul jobului de sincronizare) și orice altă colecție: inaccesibile din aplicație.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
