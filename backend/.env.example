# Copiază acest fișier în backend/.env și completează valorile.
#   cp backend/.env.example backend/.env

# PostgreSQL
POSTGRES_USER=newsfilter
POSTGRES_PASSWORD=change-me
POSTGRES_DB=newsfilter

# Cheia pe care aplicația Android o trimite în header-ul X-API-Key.
# Trebuie să fie identică cu N8N_API_KEY din local.properties (rădăcina proiectului).
# Generează una cu: openssl rand -hex 24
N8N_API_KEY=change-me

# Cheia Google Gemini API (rezumate AI, idei cheie, etichete, „Aprofundează subiectul”).
# Opțională: fără ea, aplicația afișează rezumatul RSS.
GEMINI_API_KEY=

# Domeniul Clerk (Frontend API), fără https:// — același ca CLERK_DOMAIN din local.properties.
CLERK_DOMAIN=
