<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permisiuni rețea -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Permisiune pentru notificări pe Android 13+ (API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Permisiuni pentru redarea audio în fundal (Foreground Service - Text-to-Speech) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Vizibilitatea pachetelor (Android 11+): necesară pentru a găsi browserele
         compatibile cu Chrome Custom Tabs și pentru fallback-ul ACTION_VIEW. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:name=".NewsFilterApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NewsFilter"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="35">

        <!-- Activity 1 (LAUNCHER): autentificare / creare cont / Google Sign-In.
             Dacă există deja o sesiune validă, trece direct la MainActivity. -->
        <activity
            android:name=".AuthActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.NewsFilter"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Activity 2: experiența principală (Onboarding, Feed, Salvate, Setări, Detaliu).
             Nu este exportată: se deschide doar din AuthActivity sau din notificare. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.NewsFilter" />

        <!-- Serviciu Foreground pentru redarea audio a pachetului de știri (TTS) -->
        <service
            android:name=".core.audio.NewsAudioService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Alerte de piață (FCM, topicul market_alerts): notificare + deep link -->
        <service
            android:name=".core.notifications.NewsFilterMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- WorkManager Hilt Provider configuration -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>

