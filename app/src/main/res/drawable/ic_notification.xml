<?xml version="1.0" encoding="utf-8"?>
<!--
    Iconița mică (status bar) pentru notificarea zilnică NewsFilter.
    Android cere ca small icon-ul să fie monocrom: sistemul folosește doar
    canalul alpha și o colorează singur (alb în status bar, culoarea setată
    cu setColor() în sertarul de notificări). De aceea desenăm doar în alb,
    pe fundal transparent, fără gradiente.

    Motiv: o pagină de ziar cu titlu și rânduri de text, cu un colț „pliat".
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Pagina (contur) cu colțul din dreapta-sus decupat -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M5,3h10l4,4v12c0,1.1 -0.9,2 -2,2H5c-1.1,0 -2,-0.9 -2,-2V5C3,3.9 3.9,3 5,3zM5,5v14h12V8h-3V5H5z" />

    <!-- Titlul (bloc gros) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M7,8h5v3H7z" />

    <!-- Rânduri de text -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M7,13h8v1.5H7zM7,16h6v1.5H7z" />
</vector>
